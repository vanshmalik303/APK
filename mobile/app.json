{
  "expo": {
    "name": "APKGuard",
    "slug": "apkguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#090909",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090909"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
